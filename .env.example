# Copier ce fichier en .env.local pour travailler en local.
# Sur Vercel : Project > Settings > Environment Variables.
# NE JAMAIS mettre les vraies valeurs dans le dépôt GitHub.

# Clé secrète servant à signer la session (longue chaîne aléatoire).
# Générer par exemple avec : openssl rand -hex 32
RESOLVIA_SECRET=remplacer-par-une-longue-chaine-aleatoire

# Liste des accès, sur UNE seule ligne, au format JSON.
# role : "admin" ou "testeur"
# outils (testeurs) : liste d'identifiants d'outils, ou ["*"] pour tous les outils ouverts aux testeurs
# expire (facultatif) : date AAAA-MM-JJ après laquelle le code ne fonctionne plus
RESOLVIA_ACCES=[{"code":"ADMIN-FX-xxxx","nom":"FX","role":"admin"},{"code":"ADMIN-AVOCATE-xxxx","nom":"Administratrice","role":"admin"},{"code":"NOTAIRE-EXEMPLE-xxxx","nom":"Me Exemple","role":"testeur","profession":"notaire","outils":["mediabilite"],"expire":"2027-06-30"}]

# Adresse qui reçoit les avis des testeurs (bouton « Donner mon avis »).
RESOLVIA_AVIS_EMAIL=fx@resolvia.be
